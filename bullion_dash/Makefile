# ARCH=m68k (default): classic Amiga.  ARCH=ppc: AmigaOS 4 (bullion_dash_os4)
# through the shared layer in ../os4_compat (scripts/build-example-ppc.sh).
ARCH ?= m68k

ifeq ($(ARCH),ppc)
NAME = bullion_dash
SRCS = main.c gfx.c input.c level.c render.c player.c enemy.c editor.c sound.c modplay.c
include ../os4_compat/os4c.mk
else

CC = m68k-amigaos-gcc
CFLAGS = -noixemul -O2 -m68020 -Wall -I../../amiga-bridge/include
LDFLAGS = -noixemul -g -L../../amiga-bridge -lbridge -lamiga
TARGET = bullion_dash

SRCS = main.c gfx.c input.c level.c render.c player.c enemy.c editor.c sound.c modplay.c
OBJS = $(SRCS:.c=.o)

all: $(TARGET)

$(TARGET): $(OBJS)
	$(CC) -o $@ $^ $(LDFLAGS)

%.o: %.c
	$(CC) $(CFLAGS) -c -o $@ $<

clean:
	rm -f *.o $(TARGET)

endif
